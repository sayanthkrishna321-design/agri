# ==========================================
# AGRISENTINEL X + AGRILINK AI — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your real values.
# NEVER commit the actual .env file.
# ==========================================

# --- Django DRF Backend Configuration ---
SECRET_KEY=your-strong-random-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database Configuration (MySQL required for submission) ---
DB_ENGINE=mysql
DB_NAME=agrisentinel
DB_USER=agrisentinel
DB_PASSWORD=your_mysql_password_here
DB_HOST=db
DB_PORT=3306

# --- AI & Groq Model Configuration ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# --- RAG & Safety Controls ---
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=5
RELEVANCE_THRESHOLD=0.3
MAX_INPUT_TOKENS=6000
MAX_OUTPUT_TOKENS=1000

# --- Frontend API Binding ---
VITE_API_BASE_URL=http://localhost:8000/api
CORS_ALLOWED_ORIGINS=http://localhost:5173
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# --- Optional database seed account passwords ---
# Set distinct private values before running agrisentinel/agrisentinel/seed_db.py.
SEED_FARMER_PASSWORD=replace-with-a-private-random-password
SEED_KISAN_COOP_PASSWORD=replace-with-a-private-random-password
SEED_RETAILER_PASSWORD=replace-with-a-private-random-password
SEED_APEX_SOURCING_PASSWORD=replace-with-a-private-random-password
SEED_ADMIN_PASSWORD=replace-with-a-private-random-password
